# Copy created automatically by `python -m ivr_poc init`; do not edit this template in place.
# Keep the generated .env private. See README.md and docs/CLOUD_SETUP.md for details.

# --- Local services (required) ---
BIND_HOST=127.0.0.1
FULFILLMENT_PORT=8000
SPECIALIST_PORT=8001
A2A_BASE_URL=http://127.0.0.1:8001

# Replaced with a random 32-byte token by `ivr_poc init`. Never use these placeholders as-is.
A2A_BEARER_TOKEN=GENERATE_SPECIALIST_TOKEN
CX_WEBHOOK_TOKEN=GENERATE_WEBHOOK_TOKEN

A2A_TIMEOUT_SECONDS=2
A2A_POLL_SECONDS=0.1
A2A_CARD_CACHE_SECONDS=300
DEMO_FAULTS=true
DEMO_SLOW_SECONDS=5

# --- Google Dialogflow CX (optional; required for cx-text and voice) ---
CX_PROJECT_ID=
CX_LOCATION=global
CX_AGENT_ID=
CX_LANGUAGE_CODE=en-US
CX_DETECT_TIMEOUT_SECONDS=10
# Leave blank to use `gcloud auth application-default login`. Set only if your org
# supplies a service-account key file; never paste JSON credentials into this file.
GOOGLE_APPLICATION_CREDENTIALS=

# --- LiveKit (optional; required for voice and microphone) ---
# Get URL/key/secret from your LiveKit Cloud project settings (or a self-hosted server).
# Before running `ivr_poc voice`, verify these are correct on their own with the official
# LiveKit CLI (no CX setup needed for this check):
#   brew install livekit-cli
#   lk room join --url "$LIVEKIT_URL" --api-key "$LIVEKIT_API_KEY" \
#     --api-secret "$LIVEKIT_API_SECRET" --identity smoke-test "$LIVEKIT_ROOM"
# See docs/CLOUD_SETUP.md section 6 for details.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_ROOM=a2a-ivr-demo
LIVEKIT_CALLER_ID=demo-caller

# --- Voice activity detection tuning (optional; used by the voice bridge) ---
VAD_RMS_THRESHOLD=600
VAD_SILENCE_SECONDS=0.7
VAD_MAX_UTTERANCE_SECONDS=10
