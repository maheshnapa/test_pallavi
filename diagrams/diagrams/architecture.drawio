  <diagram name="Local-only path (no cloud)" id="local-path">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="920" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="p2_cmd" value="python -m ivr_poc demo&#160;&#160;&#8594; 12 scenarios, writes artifacts/demo-results.json&#10;python -m ivr_poc chat&#160;&#160;&#8594; regex text parser simulates CX&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#8212;&#160;&#160;Python 3.11+ only, no pip, no Google Cloud, no LiveKit, no API keys" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=center;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="1120" height="56" as="geometry" />
        </mxCell>

        <mxCell id="p2_stack" value="LocalStack&#160;&#160;&#8212;&#160;&#160;one Python process (local_demo.py), both servers on ephemeral ports" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#333333;align=center;verticalAlign=top;fontSize=13;fontStyle=1;dashed=1;dashPattern=1 1;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="1120" height="690" as="geometry" />
        </mxCell>

        <mxCell id="p2_sim" value="CX simulator&#10;cx_request(session, order_id, region)&#10;builds a Dialogflow CX webhook JSON body&#10;(chat: regex extracts ORD-#### / east / west)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacing=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="70" y="160" width="320" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p2_out" value="Result&#10;a2a_status: completed / input-required /&#10;timeout / failed / superseded&#10;+ spoken text template&#10;(printed and asserted by tests)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacing=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="70" y="380" width="320" height="140" as="geometry" />
        </mxCell>

        <mxCell id="p2_ful" value="Fulfillment service&#160;&#8212;&#160;fulfillment.py&#160;&#160;(ephemeral port)&#10;POST /webhook/dialogflow-cx&#160;&#160;&#160;Bearer webhook token&#10;&#8226; validate tag order_status, params order_id / region&#10;&#8226; session + continuation (5 min) + retry dedup + supersede&#10;&#8226; render spoken template / FALLBACK&#10;returns fulfillmentResponse + sessionInfo.parameters.a2a_status" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacing=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="470" y="150" width="660" height="170" as="geometry" />
        </mxCell>
        <mxCell id="p2_client" value="A2A client&#160;&#8212;&#160;a2a_client.py&#160;&#160;(inside the fulfillment process)&#10;discover Agent Card (endpoint allowlist, protocol 0.3.0, cache 300 s)&#10;message/send (blocking=false) &#8594; poll tasks/get to the deadline&#10;(~0.6 s in demo, A2A_TIMEOUT_SECONDS otherwise)&#10;validate order_status artifact &#8594; Outcome" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacing=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="470" y="370" width="660" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p2_spec" value="Specialist service&#160;&#8212;&#160;specialist.py&#160;&#160;(ephemeral port)&#10;GET&#160;&#160;/.well-known/agent-card.json&#10;POST /a2a&#160;&#160;message/send &#183; tasks/get &#183; tasks/cancel&#160;&#160;&#160;Bearer A2A token&#10;in-memory task + background worker thread&#10;fixtures: ORD-1001 shipped &#183; ORD-1002 delivered &#183; ORD-2001 processing+region &#183; else not_found&#10;faults: ORD-SLOW slow &#183; ORD-FAIL failed &#183; ORD-BAD malformed artifact" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacing=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="470" y="570" width="660" height="190" as="geometry" />
        </mxCell>

        <mxCell id="p2_note" value="No Google Cloud, LiveKit, API keys, speech service, DB, or pip installs. Requires Python 3.11+ (system python3 here is 3.9 &#8212; use /opt/homebrew/bin/python3.13)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="830" width="1120" height="50" as="geometry" />
        </mxCell>

        <mxCell id="p2a1" value="POST webhook JSON (loopback)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="p2_sim" target="p2_ful">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2a2" value="{order_id, region}" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="p2_ful" target="p2_client">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2a3" value="GET card &#183; POST /a2a" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="p2_client" target="p2_spec">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2a4" value="response: Task + artifact" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;endFill=0;fontSize=10;strokeColor=#6c8ebf;dashed=1;dashPattern=6 4;exitX=0.25;exitY=0;exitDx=0;exitDy=0;entryX=0.25;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2_spec" target="p2_client">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2a5" value="response: Outcome" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;endFill=0;fontSize=10;strokeColor=#6c8ebf;dashed=1;dashPattern=6 4;exitX=0.25;exitY=0;exitDx=0;exitDy=0;entryX=0.25;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2_client" target="p2_ful">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2a6" value="webhook response" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="p2_ful" target="p2_out">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram name="A2A task lifecycle" id="task-lifecycle">
    <mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1120" pageHeight="720" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="p3_title" value="Specialist task lifecycle&#160;&#160;(specialist.py)&#160;&#160;&#8212; states validated by a2a_client.py" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="900" height="30" as="geometry" />
        </mxCell>

        <mxCell id="p3_start" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="90" y="70" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p3_sub" value="submitted" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="160" width="140" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p3_working" value="working" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="320" width="140" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p3_input" value="input-required" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="330" y="160" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p3_completed" value="completed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="330" y="430" width="140" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p3_failed" value="failed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="560" y="320" width="140" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p3_canceled" value="canceled" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="560" y="160" width="140" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p3_purge" value="purged&#10;300 s idle, terminal or input-required" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="780" y="430" width="200" height="70" as="geometry" />
        </mxCell>

        <mxCell id="p3e0" value="message/send (new task)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="p3_start" target="p3_sub">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3e1" value="query complete, worker acquired" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="p3_sub" target="p3_working">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3e2" value="missing order_id, or ORD-2001 without region" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="p3_sub" target="p3_input">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3e3" value="no worker slot (capacity)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="p3_sub" target="p3_failed">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3e4" value="message/send, same taskId + contextId&#10;(resume, up to 8x)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="p3_input" target="p3_working">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3e5" value="order_status artifact written" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="p3_working" target="p3_completed">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3e6" value="ORD-FAIL / backend error" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="p3_working" target="p3_failed">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3e7" value="tasks/cancel" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="p3_working" target="p3_canceled">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3e8" value="tasks/cancel" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="p3_input" target="p3_canceled">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3e9" value="tasks/cancel" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;exitX=1;exitY=0.25;exitDx=0;exitDy=0;" edge="1" parent="1" source="p3_sub" target="p3_canceled">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;dashed=1;" edge="1" parent="1" source="p3_completed" target="p3_purge">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;dashed=1;" edge="1" parent="1" source="p3_failed" target="p3_purge">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;dashed=1;" edge="1" parent="1" source="p3_canceled" target="p3_purge">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="p3_note" value="A2A client (a2a_client.py) maps states to Outcome:&#10;completed &#8594; completed&#160;&#160;&#183;&#160;&#160;input-required &#8594; input-required&#160;&#160;&#183;&#160;&#160;failed / rejected / canceled / auth-required &#8594; failed&#10;local deadline reached &#8594; timeout (then best-effort tasks/cancel)&#160;&#160;&#183;&#160;&#160;transport error &#8594; failed or timeout&#10;invalid artifact / schema / order-id correlation &#8594; failed (local FALLBACK spoken)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;align=left;verticalAlign=top;spacing=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="540" width="700" height="130" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
