<mxfile host="app.diagrams.net" agent="Claude Code" version="24.7.7" type="device">
  <diagram name="System Architecture" id="sys-arch">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1680" pageHeight="1240" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="p1_cli" value="CLI&#160;&#160;&#183;&#160;&#160;python -m ivr_poc &lt;command&gt;&#10;init &#183; demo &#183; chat &#183; serve &#183; doctor&#160;&#160;&#160;&#8594; Python 3.11+ only, no pip, no cloud&#160;&#160;&#160;&#160;&#160;&#160;|&#160;&#160;&#160;&#160;&#160;&#160;cx-text &#183; voice &#183; microphone &#183; sdk-check&#160;&#160;&#8594; need pip extras / cloud accounts" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=center;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1600" height="46" as="geometry" />
        </mxCell>

        <mxCell id="p1_caller" value="Caller&#10;headset mic + speaker&#10;identity = LIVEKIT_CALLER_ID" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacing=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="270" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p1_mic" value="microphone client&#10;connectors/microphone.py + sounddevice&#10;command: microphone&#10;&#8226; publishes caller-microphone track (16 kHz)&#10;&#8226; plays back the ivr-agent track" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacing=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="200" width="270" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p1_lk" value="LiveKit room (SFU)&#10;EXTERNAL &#183; wss:// LIVEKIT_URL&#10;room = LIVEKIT_ROOM&#10;room JWT signed locally with&#10;LIVEKIT_API_KEY / _SECRET" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacing=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="350" width="270" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p1_sdk" value="sdk-check&#10;connectors/sdk_check.py&#10;official a2a-sdk + httpx&#10;interop test against the specialist" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacing=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="510" width="270" height="110" as="geometry" />
        </mxCell>

        <mxCell id="p1_proc" value="Local Python process(es)&#160;&#160;&#8212;&#160;&#160;standard-library HTTP, in-memory state, loopback only" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#333333;align=center;verticalAlign=top;fontSize=13;fontStyle=1;spacing=6;dashPattern=1 1;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="350" y="80" width="900" height="1120" as="geometry" />
        </mxCell>

        <mxCell id="p1_bridge" value="Voice bridge&#160;&#8212;&#160;connectors/voice.py&#160;&#160;(voice)&#10;&#8226; energy VAD endpointing (VAD_* env)&#10;&#8226; buffers one utterance, PCM16 mono 16 kHz&#10;&#8226; per-utterance turn UUID; interrupt on new speech&#10;&#8226; AudioSource 24 kHz &#8594; cx-response track" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacing=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="370" y="120" width="420" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p1_cx" value="CX connector&#160;&#8212;&#160;connectors/cx.py : CXSession&#160;&#160;(cx-text / voice)&#10;&#8226; google-cloud-dialogflow-cx SessionsAsyncClient&#10;&#8226; detect_intent: text OR audio + QueryParameters.payload ivr_turn_id&#10;&#8226; input 16 kHz LINEAR16 / output 24 kHz LINEAR16&#10;&#8226; stateful session lock (no overlapping calls)&#10;&#8226; auth: Google ADC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacing=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="810" y="120" width="420" height="150" as="geometry" />
        </mxCell>

        <mxCell id="p1_ful" value="Fulfillment service&#160;&#8212;&#160;fulfillment.py&#160;&#160;(serve / demo / chat)&#160;&#160;&#160;&#160;&#160;port 8000&#10;&#10;GET&#160;&#160;/health&#10;POST /webhook/dialogflow-cx&#160;&#160;&#160;&#160;&#160;auth: Bearer CX_WEBHOOK_TOKEN&#10;POST /api/turns/start&#160;&#160;&#183;&#160;&#160;POST /api/turns/cancel&#160;&#160;(reason hangup | interruption)&#10;&#10;&#8212; per-session Turn state; continuation task reuse up to 5 idle min&#10;&#8212; CX-retry dedup by detectIntentResponseId; superseded-turn suppression&#10;&#8212; maps params to {order_id, region}; safe reply templates + FALLBACK text" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacing=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="370" y="300" width="860" height="200" as="geometry" />
        </mxCell>

        <mxCell id="p1_client" value="A2A client&#160;&#8212;&#160;a2a_client.py&#160;&#160;(runs INSIDE the fulfillment process)&#10;&#8226; discover(): GET Agent Card &#8594; endpoint allowlist + protocol 0.3.0 + order_status skill; cache 300 s&#10;&#8226; run(): message/send (blocking=false) then poll tasks/get to deadline A2A_TIMEOUT_SECONDS&#10;&#8226; validates the single order_status artifact; ignores remote prose&#10;&#8226; cancel_task(): best-effort tasks/cancel&#10;&#8226; Outcome = completed | input-required | timeout | failed | canceled" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacing=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="370" y="530" width="860" height="150" as="geometry" />
        </mxCell>

        <mxCell id="p1_spec" value="Specialist service&#160;&#8212;&#160;specialist.py&#160;&#160;(serve / demo / chat)&#160;&#160;&#160;&#160;&#160;port 8001&#10;&#10;GET&#160;&#160;/health&#10;GET&#160;&#160;/.well-known/agent-card.json&#160;&#160;&#160;(Agent Card: protocol 0.3.0, JSONRPC, order_status skill)&#10;POST /a2a&#160;&#160;&#160;JSON-RPC 2.0: message/send &#183; tasks/get &#183; tasks/cancel&#160;&#160;&#160;auth: Bearer A2A_BEARER_TOKEN (principal 'fulfillment')&#10;&#10;&#8212; in-memory tasks; 16 worker threads; capacity 128; 300 s purge&#10;&#8212; lifecycle: submitted &#8594; working &#8594; completed | failed | input-required ;&#160;&#160;tasks/cancel &#8594; canceled&#10;&#8212; fixtures: ORD-1001 shipped &#183; ORD-1002 delivered &#183; ORD-2001 processing (needs region) &#183; else not_found&#10;&#8212; fault fixtures (DEMO_FAULTS): ORD-SLOW slow &#183; ORD-FAIL failed &#183; ORD-BAD malformed artifact" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacing=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="370" y="710" width="860" height="240" as="geometry" />
        </mxCell>

        <mxCell id="p1_infra" value="Shared infrastructure&#10;http_support.py: BoundedServer, JsonHandler,&#10;bearer auth (hmac.compare_digest),&#10;request_json (no redirects, 64 KiB cap, JSON only)&#10;config.py: .env loader, Settings, validate_base_url" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacing=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="370" y="980" width="420" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p1_sim" value="Local CX simulator (NO cloud)&#10;local_demo.py: run_demo (demo) &#183; chat&#10;LocalStack: both servers, one process, ephemeral ports&#10;cx_request() builds CX-shaped webhook JSON&#10;writes artifacts/demo-results.json" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacing=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="810" y="980" width="420" height="120" as="geometry" />
        </mxCell>

        <mxCell id="p1_env" value="config: .env&#160;&#160;(python -m ivr_poc init generates CX_WEBHOOK_TOKEN + A2A_BEARER_TOKEN)&#10;BIND_HOST 127.0.0.1 &#183; FULFILLMENT_PORT 8000 &#183; SPECIALIST_PORT 8001 &#183; A2A_TIMEOUT_SECONDS 2.0 &#183; A2A_CARD_CACHE_SECONDS 300" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=middle;spacing=8;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="370" y="1120" width="860" height="60" as="geometry" />
        </mxCell>

        <mxCell id="p1_dfcx" value="Google Dialogflow CX&#160;&#160;(cx-text / voice only)&#10;gRPC dialogflow.googleapis.com:443&#10;&#8226; speech recognition (STT)&#10;&#8226; intent match + flow/page routing&#10;&#8226; webhook fulfillment call (tag order_status)&#10;&#8226; response synthesis (TTS) &#8594; output_audio&#10;CX_PROJECT_ID &#183; CX_LOCATION &#183; CX_AGENT_ID" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacing=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1290" y="120" width="350" height="220" as="geometry" />
        </mxCell>
        <mxCell id="p1_adc" value="Google OAuth / ADC&#10;accounts.google.com &#183; oauth2.googleapis.com&#10;gcloud auth application-default login" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacing=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1290" y="370" width="350" height="90" as="geometry" />
        </mxCell>
