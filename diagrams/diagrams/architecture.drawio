    <diagram name="System Architecture" id="sys-arch">
        <mxGraphModel dx="1106" dy="381" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1680" pageHeight="1240" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="p1_cli" value="CLI  ·  python -m ivr_poc &lt;command&gt;&#xa;init · demo · chat · serve · doctor   → Python 3.11+ only, no pip, no cloud      |      cx-text · voice · microphone · sdk-check  → need pip extras / cloud accounts" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=center;verticalAlign=middle;fontSize=12;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="40" y="20" width="1600" height="46" as="geometry"/>
                </mxCell>
                <mxCell id="p1_caller" value="Caller&#xa;headset mic + speaker&#xa;identity = LIVEKIT_CALLER_ID" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacing=8;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="40" y="90" width="270" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="p1_mic" value="microphone client&#xa;connectors/microphone.py + sounddevice&#xa;command: microphone&#xa;• publishes caller-microphone track (16 kHz)&#xa;• plays back the ivr-agent track" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacing=8;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="40" y="200" width="270" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="p1_lk" value="LiveKit room (SFU)&#xa;EXTERNAL · wss:// LIVEKIT_URL&#xa;room = LIVEKIT_ROOM&#xa;room JWT signed locally with&#xa;LIVEKIT_API_KEY / _SECRET" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacing=8;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="40" y="350" width="270" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="p1_sdk" value="sdk-check&#xa;connectors/sdk_check.py&#xa;official a2a-sdk + httpx&#xa;interop test against the specialist" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacing=8;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="40" y="510" width="270" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="p1_proc" value="Local Python process(es)  —  standard-library HTTP, in-memory state, loopback only" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#333333;align=center;verticalAlign=top;fontSize=13;fontStyle=1;spacing=6;dashPattern=1 1;dashed=1;" parent="1" vertex="1">
                    <mxGeometry x="350" y="80" width="900" height="1120" as="geometry"/>
                </mxCell>
                <mxCell id="p1_bridge" value="Voice bridge — connectors/voice.py  (voice)&#xa;• energy VAD endpointing (VAD_* env)&#xa;• buffers one utterance, PCM16 mono 16 kHz&#xa;• per-utterance turn UUID; interrupt on new speech&#xa;• AudioSource 24 kHz → cx-response track" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacing=8;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="370" y="120" width="420" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="p1_cx" value="CX connector — connectors/cx.py : CXSession  (cx-text / voice)&#xa;• google-cloud-dialogflow-cx SessionsAsyncClient&#xa;• detect_intent: text OR audio + QueryParameters.payload ivr_turn_id&#xa;• input 16 kHz LINEAR16 / output 24 kHz LINEAR16&#xa;• stateful session lock (no overlapping calls)&#xa;• auth: Google ADC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacing=8;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="810" y="120" width="420" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="p1_ful" value="Fulfillment service — fulfillment.py  (serve / demo / chat)     port 8000&#xa;&#xa;GET  /health&#xa;POST /webhook/dialogflow-cx     auth: Bearer CX_WEBHOOK_TOKEN&#xa;POST /api/turns/start  ·  POST /api/turns/cancel  (reason hangup | interruption)&#xa;&#xa;— per-session Turn state; continuation task reuse up to 5 idle min&#xa;— CX-retry dedup by detectIntentResponseId; superseded-turn suppression&#xa;— maps params to {order_id, region}; safe reply templates + FALLBACK text" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacing=8;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="370" y="300" width="860" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="p1_client" value="A2A client — a2a_client.py  (runs INSIDE the fulfillment process)&#xa;• discover(): GET Agent Card → endpoint allowlist + protocol 0.3.0 + order_status skill; cache 300 s&#xa;• run(): message/send (blocking=false) then poll tasks/get to deadline A2A_TIMEOUT_SECONDS&#xa;• validates the single order_status artifact; ignores remote prose&#xa;• cancel_task(): best-effort tasks/cancel&#xa;• Outcome = completed | input-required | timeout | failed | canceled" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacing=8;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="370" y="530" width="860" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="p1_spec" value="Specialist service — specialist.py  (serve / demo / chat)     port 8001&#xa;&#xa;GET  /health&#xa;GET  /.well-known/agent-card.json   (Agent Card: protocol 0.3.0, JSONRPC, order_status skill)&#xa;POST /a2a   JSON-RPC 2.0: message/send · tasks/get · tasks/cancel   auth: Bearer A2A_BEARER_TOKEN (principal &#39;fulfillment&#39;)&#xa;&#xa;— in-memory tasks; 16 worker threads; capacity 128; 300 s purge&#xa;— lifecycle: submitted → working → completed | failed | input-required ;  tasks/cancel → canceled&#xa;— fixtures: ORD-1001 shipped · ORD-1002 delivered · ORD-2001 processing (needs region) · else not_found&#xa;— fault fixtures (DEMO_FAULTS): ORD-SLOW slow · ORD-FAIL failed · ORD-BAD malformed artifact" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacing=8;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="370" y="710" width="860" height="240" as="geometry"/>
                </mxCell>
                <mxCell id="p1_infra" value="Shared infrastructure&#xa;http_support.py: BoundedServer, JsonHandler,&#xa;bearer auth (hmac.compare_digest),&#xa;request_json (no redirects, 64 KiB cap, JSON only)&#xa;config.py: .env loader, Settings, validate_base_url" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacing=8;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="370" y="980" width="420" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="p1_sim" value="Local CX simulator (NO cloud)&#xa;local_demo.py: run_demo (demo) · chat&#xa;LocalStack: both servers, one process, ephemeral ports&#xa;cx_request() builds CX-shaped webhook JSON&#xa;writes artifacts/demo-results.json" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacing=8;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="810" y="980" width="420" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="p1_env" value="config: .env  (python -m ivr_poc init generates CX_WEBHOOK_TOKEN + A2A_BEARER_TOKEN)&#xa;BIND_HOST 127.0.0.1 · FULFILLMENT_PORT 8000 · SPECIALIST_PORT 8001 · A2A_TIMEOUT_SECONDS 2.0 · A2A_CARD_CACHE_SECONDS 300" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=middle;spacing=8;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="370" y="1120" width="860" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="p1_dfcx" value="Google Dialogflow CX  (cx-text / voice only)&#xa;gRPC dialogflow.googleapis.com:443&#xa;• speech recognition (STT)&#xa;• intent match + flow/page routing&#xa;• webhook fulfillment call (tag order_status)&#xa;• response synthesis (TTS) → output_audio&#xa;CX_PROJECT_ID · CX_LOCATION · CX_AGENT_ID" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacing=8;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="1290" y="120" width="350" height="220" as="geometry"/>
                </mxCell>
                <mxCell id="p1_adc" value="Google OAuth / ADC&#xa;accounts.google.com · oauth2.googleapis.com&#xa;gcloud auth application-default login" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacing=8;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="1290" y="370" width="350" height="90" as="geometry"/>
