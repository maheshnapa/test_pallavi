                <mxCell id="p2_cmd" value="python -m ivr_poc demo  → 12 scenarios, writes artifacts/demo-results.json&#xa;python -m ivr_poc chat  → regex text parser simulates CX       —  Python 3.11+ only, no pip, no Google Cloud, no LiveKit, no API keys" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=center;verticalAlign=middle;fontSize=12;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="40" y="30" width="1120" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="p2_stack" value="LocalStack  —  one Python process (local_demo.py), both servers on ephemeral ports" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#333333;align=center;verticalAlign=top;fontSize=13;fontStyle=1;dashed=1;dashPattern=1 1;" parent="1" vertex="1">
                    <mxGeometry x="40" y="110" width="1120" height="690" as="geometry"/>
