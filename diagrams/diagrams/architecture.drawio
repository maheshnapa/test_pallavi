        <mxCell id="p1_legend" value="Legend&#10;&#10;blue&#160;&#160;&#160;= local service, always on, Python only&#10;green&#160;= local connector, needs pip extras&#10;orange = external service (cloud mode only)&#10;gray&#160;&#160;&#160;= config / actor / simulator&#10;&#10;solid edge&#160;&#160;= local path&#10;dashed edge = cloud-only path" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;align=left;verticalAlign=top;spacing=8;fontSize=11;" vertex="1" parent="1">
