    <diagram name="Local-only path (no cloud)" id="local-path">
        <mxGraphModel dx="1106" dy="381" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="920" math="0" shadow="0">
