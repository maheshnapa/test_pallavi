                <mxCell id="p2_out" value="Result&#xa;a2a_status: completed / input-required /&#xa;timeout / failed / superseded&#xa;+ spoken text template&#xa;(printed and asserted by tests)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacing=8;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="70" y="380" width="320" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="p2_ful" value="Fulfillment service — fulfillment.py  (ephemeral port)&#xa;POST /webhook/dialogflow-cx   Bearer webhook token&#xa;• validate tag order_status, params order_id / region&#xa;• session + continuation (5 min) + retry dedup + supersede&#xa;• render spoken template / FALLBACK&#xa;returns fulfillmentResponse + sessionInfo.parameters.a2a_status" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacing=8;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="470" y="150" width="660" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="p2_client" value="A2A client — a2a_client.py  (inside the fulfillment process)&#xa;discover Agent Card (endpoint allowlist, protocol 0.3.0, cache 300 s)&#xa;message/send (blocking=false) → poll tasks/get to the deadline&#xa;(~0.6 s in demo, A2A_TIMEOUT_SECONDS otherwise)&#xa;validate order_status artifact → Outcome" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacing=8;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="470" y="370" width="660" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="p2_spec" value="Specialist service — specialist.py  (ephemeral port)&#xa;GET  /.well-known/agent-card.json&#xa;POST /a2a  message/send · tasks/get · tasks/cancel   Bearer A2A token&#xa;in-memory task + background worker thread&#xa;fixtures: ORD-1001 shipped · ORD-1002 delivered · ORD-2001 processing+region · else not_found&#xa;faults: ORD-SLOW slow · ORD-FAIL failed · ORD-BAD malformed artifact" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacing=8;fontSize=11;" parent="1" vertex="1">
