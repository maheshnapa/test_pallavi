    <diagram name="A2A task lifecycle" id="task-lifecycle">
        <mxGraphModel dx="1106" dy="381" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1120" pageHeight="720" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="p3_title" value="Specialist task lifecycle  (specialist.py)  — states validated by a2a_client.py" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="40" y="20" width="900" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="p3_start" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="90" y="70" width="30" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="p3_sub" value="submitted" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="40" y="160" width="140" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="p3_working" value="working" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="40" y="320" width="140" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="p3_input" value="input-required" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="330" y="160" width="160" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="p3_completed" value="completed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="330" y="430" width="140" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="p3_failed" value="failed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="560" y="320" width="140" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="p3_canceled" value="canceled" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="560" y="160" width="140" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="p3_purge" value="purged&#xa;300 s idle, terminal or input-required" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="780" y="430" width="200" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="p3e0" value="message/send (new task)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;" parent="1" source="p3_start" target="p3_sub" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p3e1" value="query complete, worker acquired" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;" parent="1" source="p3_sub" target="p3_working" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p3e2" value="missing order_id, or ORD-2001 without region" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;" parent="1" source="p3_sub" target="p3_input" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p3e3" value="no worker slot (capacity)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;" parent="1" source="p3_sub" target="p3_failed" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p3e4" value="message/send, same taskId + contextId&#xa;(resume, up to 8x)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;" parent="1" source="p3_input" target="p3_working" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p3e5" value="order_status artifact written" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;" parent="1" source="p3_working" target="p3_completed" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p3e6" value="ORD-FAIL / backend error" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;" parent="1" source="p3_working" target="p3_failed" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p3e7" value="tasks/cancel" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;" parent="1" source="p3_working" target="p3_canceled" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p3e8" value="tasks/cancel" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;" parent="1" source="p3_input" target="p3_canceled" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p3e9" value="tasks/cancel" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;exitX=1;exitY=0.25;exitDx=0;exitDy=0;" parent="1" source="p3_sub" target="p3_canceled" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p3e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;dashed=1;" parent="1" source="p3_completed" target="p3_purge" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p3e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;dashed=1;" parent="1" source="p3_failed" target="p3_purge" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p3e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;dashed=1;" parent="1" source="p3_canceled" target="p3_purge" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p3_note" value="A2A client (a2a_client.py) maps states to Outcome:&#xa;completed → completed  ·  input-required → input-required  ·  failed / rejected / canceled / auth-required → failed&#xa;local deadline reached → timeout (then best-effort tasks/cancel)  ·  transport error → failed or timeout&#xa;invalid artifact / schema / order-id correlation → failed (local FALLBACK spoken)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;align=left;verticalAlign=top;spacing=8;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="40" y="540" width="700" height="130" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
