<mxfile host="65bd71144e">
    <diagram name="How a call works" id="simple-flow">
        <mxGraphModel dx="1106" dy="729" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1180" pageHeight="540" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="How an order-status call works" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#0F172A;" parent="1" vertex="1">
                    <mxGeometry x="50" y="24" width="1000" height="32" as="geometry"/>
                </mxCell>
                <mxCell id="subtitle" value="A caller asks about an order by phone. The system understands the request, looks it up, and speaks the answer back." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#475569;" parent="1" vertex="1">
                    <mxGeometry x="50" y="58" width="1050" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="b1" value="Caller&#xa;&#xa;Asks: “Where is my order ORD-1001?”" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F1F5F9;strokeColor=#334155;fontSize=13;fontColor=#0F172A;spacingLeft=6;spacingRight=6;" parent="1" vertex="1">
                    <mxGeometry x="50" y="150" width="188" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="b2" value="Voice channel&#xa;&#xa;LiveKit carries the live call audio" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F1F5F9;strokeColor=#334155;fontSize=13;fontColor=#0F172A;spacingLeft=6;spacingRight=6;" parent="1" vertex="1">
                    <mxGeometry x="262" y="150" width="188" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="b3" value="Google Dialogflow CX&#xa;&#xa;Understands speech, runs the conversation, speaks the reply" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#E8F0FE;strokeColor=#1A73E8;fontSize=13;fontColor=#0F172A;spacingLeft=6;spacingRight=6;" parent="1" vertex="1">
                    <mxGeometry x="474" y="150" width="188" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="b4" value="Fulfillment service&#xa;&#xa;Our adapter — turns the request into a task for the specialist" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F1F5F9;strokeColor=#334155;fontSize=13;fontColor=#0F172A;spacingLeft=6;spacingRight=6;" parent="1" vertex="1">
                    <mxGeometry x="686" y="150" width="188" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="b5" value="Order-status specialist agent&#xa;&#xa;Looks up the order and returns its status (A2A agent protocol)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F1F5F9;strokeColor=#334155;fontSize=13;fontColor=#0F172A;spacingLeft=6;spacingRight=6;" parent="1" vertex="1">
                    <mxGeometry x="898" y="150" width="188" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="a1" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#64748B;strokeWidth=2;endFill=1;" parent="1" source="b1" target="b2" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="a2" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#64748B;strokeWidth=2;endFill=1;" parent="1" source="b2" target="b3" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="a3" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#64748B;strokeWidth=2;endFill=1;" parent="1" source="b3" target="b4" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="a4" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#64748B;strokeWidth=2;endFill=1;" parent="1" source="b4" target="b5" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="ret" value="Spoken answer:  “Order ORD-1001 has shipped and is on the way.”" style="endArrow=block;html=1;rounded=0;strokeColor=#1A73E8;strokeWidth=2;dashed=1;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;fontSize=12;fontColor=#1A73E8;fontStyle=1;" parent="1" source="b5" target="b1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="992" y="360"/>
                            <mxPoint x="144" y="360"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="foot" value="Demo order data is fictitious. No real customer, billing, or payment systems are connected." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#64748B;fontStyle=2;" parent="1" vertex="1">
                    <mxGeometry x="50" y="430" width="1050" height="24" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
