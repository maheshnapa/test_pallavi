        <mxCell id="ll_ful" value="Fulfillment&#10;fulfillment.py :8000" style="shape=umlLifeline;perimeter=lifelinePerimeter;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="900" y="56" width="170" height="920" as="geometry" />
        </mxCell>
        <mxCell id="ll_client" value="A2A client&#10;a2a_client.py" style="shape=umlLifeline;perimeter=lifelinePerimeter;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1130" y="56" width="150" height="920" as="geometry" />
