        </mxCell>
        <mxCell id="ll_lk" value="LiveKit room" style="shape=umlLifeline;perimeter=lifelinePerimeter;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#d6f5f3;strokeColor=#1FBEC9;fontStyle=1;" vertex="1" parent="1">
