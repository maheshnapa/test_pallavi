        <mxCell id="ll_bridge" value="Voice bridge&#10;voice.py" style="shape=umlLifeline;perimeter=lifelinePerimeter;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="460" y="56" width="150" height="920" as="geometry" />
        </mxCell>
        <mxCell id="ll_cx" value="Dialogflow CX&#10;(Google)" style="shape=umlLifeline;perimeter=lifelinePerimeter;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#e8f0fe;strokeColor=#4285F4;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="670" y="56" width="160" height="920" as="geometry" />
