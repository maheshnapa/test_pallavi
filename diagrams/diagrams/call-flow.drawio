<mxfile host="app.diagrams.net" agent="Claude Code" version="24.7.7" type="device">
  <diagram name="Call flow — CX to LiveKit" id="callflow-main">
    <mxGraphModel dx="1500" dy="960" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1420" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="banner" value="End-to-end voice call flow  —  python -m ivr_poc voice   (caller ⇆ LiveKit ⇆ audio bridge ⇆ Dialogflow CX ⇆ fulfillment ⇆ A2A specialist)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1640" height="44" as="geometry" />
        </mxCell>

        <!-- ============ CALLER ============ -->
        <mxCell id="caller" value="Caller" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#f5f5f5;strokeColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="70" y="150" width="70" height="120" as="geometry" />
        </mxCell>
        <mxCell id="miccli" value="microphone client&#10;connectors/microphone.py&#10;sounddevice + LiveKit RTC&#10;(local stand-in for a real caller)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacing=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="30" y="330" width="220" height="110" as="geometry" />
        </mxCell>

        <!-- ============ LIVEKIT (composed mark) ============ -->
        <mxCell id="lk_grp" value="" style="group" vertex="1" connectable="0" parent="1">
          <mxGeometry x="330" y="150" width="140" height="120" as="geometry" />
        </mxCell>
        <mxCell id="lk_sq" value="" style="rounded=1;arcSize=22;fillColor=#1FBEC9;strokeColor=none;html=1;" vertex="1" parent="lk_grp">
          <mxGeometry x="0" y="0" width="140" height="120" as="geometry" />
        </mxCell>
        <mxCell id="lk_b1" value="" style="rounded=1;arcSize=40;fillColor=#FFFFFF;strokeColor=none;html=1;" vertex="1" parent="lk_grp">
          <mxGeometry x="20" y="42" width="14" height="36" as="geometry" />
        </mxCell>
        <mxCell id="lk_b2" value="" style="rounded=1;arcSize=40;fillColor=#FFFFFF;strokeColor=none;html=1;" vertex="1" parent="lk_grp">
          <mxGeometry x="42" y="30" width="14" height="60" as="geometry" />
        </mxCell>
        <mxCell id="lk_b3" value="" style="rounded=1;arcSize=40;fillColor=#FFFFFF;strokeColor=none;html=1;" vertex="1" parent="lk_grp">
          <mxGeometry x="64" y="18" width="14" height="84" as="geometry" />
        </mxCell>
        <mxCell id="lk_b4" value="" style="rounded=1;arcSize=40;fillColor=#FFFFFF;strokeColor=none;html=1;" vertex="1" parent="lk_grp">
          <mxGeometry x="86" y="34" width="14" height="52" as="geometry" />
        </mxCell>
        <mxCell id="lk_b5" value="" style="rounded=1;arcSize=40;fillColor=#FFFFFF;strokeColor=none;html=1;" vertex="1" parent="lk_grp">
          <mxGeometry x="108" y="46" width="14" height="28" as="geometry" />
        </mxCell>
        <mxCell id="lk_lbl" value="LiveKit&#10;room SFU  ·  wss:// LIVEKIT_URL&#10;room = LIVEKIT_ROOM&#10;room JWT signed locally (API key / secret)" style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="290" y="280" width="220" height="70" as="geometry" />
        </mxCell>

        <!-- ============ LOCAL PROCESS ============ -->
        <mxCell id="proc" value="Local Python process  —  loopback only, standard-library HTTP, in-memory state" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#333333;align=center;verticalAlign=top;fontSize=13;fontStyle=1;dashed=1;dashPattern=1 1;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="560" y="90" width="520" height="1260" as="geometry" />
        </mxCell>
        <mxCell id="bridge" value="Voice bridge  —  connectors/voice.py&#10;• energy VAD, buffers one utterance (PCM16 mono 16 kHz)&#10;• new turn UUID per utterance; barge-in via generation counter&#10;• publishes CX reply on a 24 kHz LiveKit track" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacing=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="580" y="150" width="480" height="140" as="geometry" />
        </mxCell>
        <mxCell id="cxconn" value="CX connector  —  connectors/cx.py : CXSession&#10;• detect_intent(audio | text, QueryParameters.payload.ivr_turn_id)&#10;• stateful session lock — no overlapping detectIntent calls&#10;• auth: Google Application Default Credentials" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacing=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="580" y="330" width="480" height="120" as="geometry" />
        </mxCell>
        <mxCell id="ful" value="Fulfillment service  —  fulfillment.py     port 8000&#10;POST /webhook/dialogflow-cx     Bearer CX_WEBHOOK_TOKEN&#10;POST /api/turns/start  ·  POST /api/turns/cancel&#10;— per-session Turn state; continuation reuse up to 5 idle min&#10;— CX-retry dedup; superseded-turn suppression&#10;— maps params to {order_id, region}; reply templates + FALLBACK" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacing=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="580" y="490" width="480" height="170" as="geometry" />
        </mxCell>
        <mxCell id="client" value="A2A client  —  a2a_client.py   (in the fulfillment process)&#10;• discover Agent Card: endpoint allowlist + protocol 0.3.0 + order_status; cache 300 s&#10;• message/send (blocking=false) → poll tasks/get to A2A_TIMEOUT_SECONDS&#10;• validate the one order_status artifact; ignore remote prose&#10;• Outcome = completed | input-required | timeout | failed | canceled" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacing=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="580" y="700" width="480" height="150" as="geometry" />
        </mxCell>
        <mxCell id="spec" value="A2A order specialist  —  specialist.py     port 8001&#10;GET  /.well-known/agent-card.json&#10;POST /a2a   JSON-RPC 2.0: message/send · tasks/get · tasks/cancel&#10;Bearer A2A_BEARER_TOKEN  (principal 'fulfillment')&#10;— in-memory tasks; 16 worker threads; capacity 128; 300 s purge&#10;— fixtures ORD-1001/1002/2001 · faults ORD-SLOW / ORD-FAIL / ORD-BAD" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacing=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="580" y="890" width="480" height="180" as="geometry" />
        </mxCell>
        <mxCell id="envnote" value=".env  —  python -m ivr_poc init generates CX_WEBHOOK_TOKEN + A2A_BEARER_TOKEN   ·   ports 8000 / 8001   ·   A2A_CARD_CACHE_SECONDS 300" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=middle;spacing=8;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="580" y="1110" width="480" height="60" as="geometry" />
        </mxCell>
        <mxCell id="bargenote" value="Barge-in / hang-up:  the bridge increments a generation counter, clears queued reply audio, and POSTs /api/turns/cancel (reason interruption or hangup).  A late webhook for a cancelled turn returns a2a_status 'superseded' with no speech.  An interruption preserves a task already waiting for clarification." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="580" y="1190" width="480" height="120" as="geometry" />
        </mxCell>

        <!-- ============ GOOGLE CLOUD ============ -->
        <mxCell id="gc" value="☁  Google Cloud     (used only by cx-text and voice)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#4285F4;dashed=1;align=center;verticalAlign=top;fontSize=13;fontStyle=1;fontColor=#1A73E8;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="1160" y="110" width="500" height="600" as="geometry" />
        </mxCell>
        <mxCell id="dfcx_icon" value="" style="sketch=0;html=1;fillColor=#4386FA;strokeColor=none;outlineConnect=0;shape=mxgraph.gcp2.dialogflow_enterprise_edition;" vertex="1" parent="1">
          <mxGeometry x="1190" y="170" width="72" height="72" as="geometry" />
        </mxCell>
        <mxCell id="dfcx_txt" value="Dialogflow CX agent&#10;CX_PROJECT_ID · CX_LOCATION · CX_AGENT_ID&#10;detectIntent  (gRPC dialogflow.googleapis.com:443)&#10;speech recognition + intent routing + speech synthesis" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#4285F4;align=left;verticalAlign=top;spacing=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1280" y="160" width="350" height="110" as="geometry" />
        </mxCell>
        <mxCell id="auth" value="🔒  Google OAuth / ADC&#10;accounts.google.com · oauth2.googleapis.com&#10;gcloud auth application-default login" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#4285F4;align=left;verticalAlign=top;spacing=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1190" y="320" width="440" height="90" as="geometry" />
        </mxCell>
        <mxCell id="dfcx_note" value="Inside one detectIntent call, Dialogflow CX:&#10;1) runs speech-to-text on the caller audio&#10;2) matches an intent and selects the webhook tag order_status&#10;3) calls the webhook fulfillment&#10;4) synthesizes the reply to output_audio (mono PCM16, 24 kHz)" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;size=16;align=left;verticalAlign=top;spacing=8;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1190" y="450" width="440" height="130" as="geometry" />
        </mxCell>
        <mxCell id="tunnel" value="HTTPS tunnel  —  public ingress&#10;public https:// hostname → 127.0.0.1:8000&#10;lets cloud CX reach the laptop webhook" style="shape=cloud;whiteSpace=wrap;html=1;fillColor=#fde7d3;strokeColor=#d79b00;align=center;verticalAlign=middle;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1210" y="740" width="400" height="150" as="geometry" />
        </mxCell>

        <!-- ============ FLOW EDGES ============ -->
        <mxCell id="e1" value="1 · speaks" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#1F9EAE;" edge="1" parent="1" source="caller" target="miccli">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="2 · publish caller-microphone track&#10;PCM16 mono 16 kHz (WebRTC)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#1F9EAE;" edge="1" parent="1" source="miccli" target="lk_grp">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="3 · subscribe caller audio track" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#1F9EAE;" edge="1" parent="1" source="lk_grp" target="bridge">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="4 · POST /api/turns/start&#10;{session_id, turn_id}   Bearer CX_WEBHOOK_TOKEN" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;exitX=1;exitY=0.15;exitDx=0;exitDy=0;entryX=1;entryY=0.1;entryDx=0;entryDy=0;" edge="1" parent="1" source="bridge" target="ful">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="5 · buffered utterance PCM + turn_id" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="bridge" target="cxconn">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="6 · detectIntent(audio, payload.ivr_turn_id)&#10;gRPC :443   (ADC token)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;dashed=1;strokeColor=#E8710A;" edge="1" parent="1" source="cxconn" target="dfcx_icon">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6b" value="6a · get ADC access token" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;dashed=1;strokeColor=#E8710A;" edge="1" parent="1" source="cxconn" target="auth">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" value="7 · webhook call" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;dashed=1;strokeColor=#E8710A;" edge="1" parent="1" source="dfcx_icon" target="tunnel">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" value="8 · POST /webhook/dialogflow-cx&#10;fulfillmentInfo.tag = order_status&#10;sessionInfo.parameters order_id / region&#10;Bearer CX_WEBHOOK_TOKEN" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;dashed=1;strokeColor=#E8710A;" edge="1" parent="1" source="tunnel" target="ful">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9" value="9 · run(query {order_id, region})" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="ful" target="client">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e10" value="10 · GET agent-card.json  (cache miss)&#10;11 · POST /a2a  message/send  (blocking=false)&#10;Bearer A2A_BEARER_TOKEN" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;exitX=0.35;exitY=1;exitDx=0;exitDy=0;entryX=0.35;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="client" target="spec">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e11" value="12 · Task { state: working }" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;endFill=0;fontSize=10;dashed=1;dashPattern=6 4;strokeColor=#6c8ebf;exitX=0.65;exitY=0;exitDx=0;exitDy=0;entryX=0.65;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="spec" target="client">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e12" value="13 · POST /a2a  tasks/get&#10;poll until terminal state or deadline" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="client" target="spec">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="760" y="870" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e13" value="14 · Task { completed } + order_status artifact" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;endFill=0;fontSize=10;dashed=1;dashPattern=6 4;strokeColor=#6c8ebf;exitX=0.8;exitY=0;exitDx=0;exitDy=0;entryX=0.8;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="spec" target="client">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e14" value="15 · Outcome&#10;completed | input-required | timeout | failed" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;endFill=0;fontSize=10;dashed=1;dashPattern=6 4;strokeColor=#6c8ebf;exitX=0.65;exitY=0;exitDx=0;exitDy=0;entryX=0.65;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="client" target="ful">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e15" value="16 · HTTP 200 WebhookResponse&#10;fulfillmentResponse.messages + sessionInfo.parameters&#10;(a2a_status, a2a_task_id, a2a_context_id, a2a_missing_field)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;dashed=1;strokeColor=#E8710A;exitX=1;exitY=0.85;exitDx=0;exitDy=0;entryX=0.2;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="ful" target="tunnel">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e16" value="17 · webhook response" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;dashed=1;strokeColor=#E8710A;" edge="1" parent="1" source="tunnel" target="dfcx_icon">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e17" value="18 · DetectIntentResponse&#10;+ output_audio (24 kHz)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;dashed=1;strokeColor=#E8710A;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=1;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="1" source="dfcx_icon" target="cxconn">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e18" value="19 · Reply(text, audio)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;endFill=0;fontSize=10;dashed=1;dashPattern=6 4;strokeColor=#82b366;" edge="1" parent="1" source="cxconn" target="bridge">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e19" value="20 · publish cx-response track (24 kHz)&#10;only if the turn is still current" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#1F9EAE;exitX=0;exitY=0.3;exitDx=0;exitDy=0;entryX=1;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="1" source="bridge" target="lk_grp">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e20" value="21 · agent reply audio" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#1F9EAE;" edge="1" parent="1" source="lk_grp" target="miccli">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e21" value="22 · caller hears the answer" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#1F9EAE;" edge="1" parent="1" source="miccli" target="caller">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ebarge" value="barge-in: POST /api/turns/cancel&#10;reason = interruption" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;dashed=1;strokeColor=#B85450;exitX=1;exitY=0.85;exitDx=0;exitDy=0;entryX=1;entryY=0.9;entryDx=0;entryDy=0;" edge="1" parent="1" source="bridge" target="ful">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="legend2" value="Legend&#10;•  teal edge  —  real-time audio / WebRTC (LiveKit)&#10;•  orange dashed  —  Google Cloud call or webhook (cloud mode only)&#10;•  blue solid  —  local HTTP or in-process call&#10;•  blue dashed  —  return value&#10;•  red dashed  —  cancellation / barge-in&#10;&#10;green box = local connector (needs requirements-cloud.txt)&#10;blue box = local service (Python only, no cloud)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;align=left;verticalAlign=top;spacing=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="70" y="470" width="430" height="210" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram name="Sequence — happy path" id="callflow-seq">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1520" pageHeight="1040" math="0" shadow="0">
      <root>
        <mxCell id="0" />
